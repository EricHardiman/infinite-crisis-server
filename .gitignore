# runtime output (contains machine name / account details)
logs/
__pycache__/
*.pyc

# generated from the client, too big for git (160 MB)
tools/analysis/full.asm

# never commit game files or executables
*.exe
*.rp
*.dll

# your own login key, generated by: python tools/patch_client.py --newkey
keys/server_private.pem
